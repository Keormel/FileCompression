# ---- Docker / host -------------------------------------------------------
# User and group that own the data directory on the host (`id -u`, `id -g`).
PUID=1000
PGID=1000
# Where transfers are stored on the host. Use an external SSD/HDD for big files,
# e.g. /mnt/ssd/filecomp. The directory must exist and belong to PUID:PGID.
FILECOMP_DATA_DIR=./data

# ---- Network ------------------------------------------------------------
FILECOMP_WEB_HOST=0.0.0.0
FILECOMP_WEB_PORT=8000
# Leave empty to detect the LAN address automatically (works with network_mode: host).
# Set one of these when the address cannot be detected (bridge network, reverse proxy):
FILECOMP_PUBLIC_HOST=
FILECOMP_PUBLIC_URL=
FILECOMP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Performance (Raspberry Pi) ----------------------------------------
# Compression processes; empty = one per CPU core (4 on a Pi 4/5).
# Lower it on a Pi with 1 GB RAM or when the board overheats.
FILECOMP_WORKERS=
FILECOMP_MAX_CONCURRENT_COMPRESSIONS=1

# ---- Many users at once ---------------------------------------------------
# Uploads receiving data at the same time; over Wi-Fi they are network-bound, so this can be high.
FILECOMP_MAX_CONCURRENT_UPLOADS=16
# Per device, so one phone (or a few stuck ones) cannot take every slot.
FILECOMP_MAX_UPLOADS_PER_CLIENT=2
# Uploads plus queued compressions; above this the server answers 503 + Retry-After
# and the web page retries by itself.
FILECOMP_MAX_PENDING_JOBS=32
# Seconds an upload may wait for a free slot before it is told to retry.
FILECOMP_UPLOAD_SLOT_WAIT_SECONDS=15
# An upload that sends nothing for this long (phone asleep, Wi-Fi gone) is dropped.
FILECOMP_UPLOAD_IDLE_TIMEOUT_SECONDS=30
# Open connections; beyond this new requests get an immediate 503.
FILECOMP_MAX_CONNECTIONS=256

# ---- Storage limits (bytes) ---------------------------------------------
# Largest accepted upload (4 GiB).
FILECOMP_MAX_UPLOAD_BYTES=4294967296
# Total size of all stored transfers, archives plus kept originals (16 GiB), and their count.
FILECOMP_MAX_TRANSFER_BYTES=17179869184
FILECOMP_MAX_TRANSFERS=32
# Keep the uploaded file next to its archive: downloads skip decompression, but use about twice the disk.
FILECOMP_KEEP_ORIGINAL=true
# Uploads are refused when less than this would stay free on the data disk (512 MiB).
FILECOMP_MIN_FREE_BYTES=536870912
# Transfers are deleted this many seconds after they are created.
FILECOMP_TRANSFER_TTL_SECONDS=1800

# ---- Hotspot admin panel (http://10.42.0.1:8000/admin/hotspot) ----------
# The panel and its API exist only while a password is set (they answer 404 otherwise).
FILECOMP_HOTSPOT_ADMIN_PASSWORD=
# Wi-Fi interface of the access point.
FILECOMP_HOTSPOT_IFACE=wlan0
# dnsmasq lease file written by NetworkManager; empty = /var/lib/NetworkManager/dnsmasq-<iface>.leases
FILECOMP_HOTSPOT_LEASES=
# Kicking and blocking need extra container rights from docker-compose.hotspot.yml;
# uncomment to include it in every `docker compose` command:
# COMPOSE_FILE=docker-compose.yml:docker-compose.hotspot.yml

# ---- Misc ---------------------------------------------------------------
FILECOMP_LOG_LEVEL=INFO
# Keep false unless the TCP relay is separately secured and network-restricted.
FILECOMP_ENABLE_SESSIONS=false
FILECOMP_TRANSFER_HOST=
FILECOMP_API_KEY=
FILECOMP_RATE_LIMIT_WINDOW_SECONDS=60
# POST requests per client per window; GET requests (page, polling, downloads) have their own budget.
FILECOMP_RATE_LIMIT_REQUESTS=120
FILECOMP_RATE_LIMIT_READ_REQUESTS=1200
